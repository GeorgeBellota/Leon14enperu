# El cPanel corre Apache: aquí sí valen los .htaccess.
#
# Lo único que se sirve de esta carpeta es enviar.php. Todo lo demás queda
# fuera del alcance del navegador: config.php lleva el token y registro.log,
# las direcciones de quien escribe.
<FilesMatch "\.(php)$">
  Require all denied
</FilesMatch>

<Files "enviar.php">
  Require all granted
</Files>

# probar.php pide el token por la URL antes de enseñar nada, asi que puede
# servirse. Aun asi: borralo del servidor cuando termines la puesta en marcha.
<Files "probar.php">
  Require all granted
</Files>

<FilesMatch "\.(log|md|txt|ejemplo\.php)$">
  Require all denied
</FilesMatch>

Options -Indexes
